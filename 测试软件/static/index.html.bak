<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI系统提示词测试</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-page: #f0f2f5;
            --bg-card: #ffffff;
            --bg-hover: #eef0f4;
            --bg-input: #f5f6f8;
            --border: #dde0e5;
            --border-light: #c8ccd3;
            --text-primary: #1a1d24;
            --text-secondary: #4a5568;
            --text-muted: #718096;
            --accent: #3b82f6;
            --accent-hover: #2563eb;
            --accent-light: rgba(59, 130, 246, 0.15);
            --accent-bg: rgba(59, 130, 246, 0.08);
            --shadow-sm: 0 1px 2px rgba(0,0,0,0.04);
            --shadow-md: 0 2px 8px rgba(0,0,0,0.06);
            --shadow-lg: 0 4px 16px rgba(0,0,0,0.08);
            --radius-sm: 6px;
            --radius-md: 10px;
            --radius-lg: 14px;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        html, body {
            height: 100vh;
            overflow: hidden;
            margin: 0;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: var(--bg-page);
            color: var(--text-primary);
            height: 100%;
            display: flex;
            flex-direction: column;
            line-height: 1.5;
        }

        .header {
            background: var(--bg-card);
            border-bottom: 1px solid var(--border);
            padding: 14px 24px;
            height: 60px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: var(--shadow-sm);
        }

        .header-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 16px;
            font-weight: 600;
            color: var(--text-primary);
        }

        .header-brand svg {
            width: 24px;
            height: 24px;
            color: var(--accent);
        }

        .header-badge {
            font-size: 11px;
            padding: 4px 10px;
            background: var(--accent-bg);
            color: var(--accent);
            border-radius: 20px;
            font-weight: 500;
        }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .settings-toggle {
            padding: 6px 12px;
            background: transparent;
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            color: var(--text-secondary);
            font-size: 12px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: all 0.2s;
        }

        .settings-toggle:hover {
            background: var(--bg-hover);
            border-color: var(--border-light);
        }

        .settings-toggle.active {
            background: var(--accent-bg);
            border-color: var(--accent);
            color: var(--accent);
        }

        .settings-toggle svg {
            width: 14px;
            height: 14px;
        }

        .params-modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.5);
            z-index: 1000;
            align-items: center;
            justify-content: center;
        }

        .params-modal-overlay.show {
            display: flex;
        }

        .params-modal {
            background: var(--bg-card);
            border-radius: var(--radius-lg);
            width: 90%;
            max-width: 600px;
            max-height: 80vh;
            display: flex;
            flex-direction: column;
            box-shadow: var(--shadow-lg);
        }

        .params-modal-header {
            padding: 16px 20px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-shrink: 0;
        }

        .params-modal-title {
            font-size: 15px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .params-modal-title svg {
            width: 18px;
            height: 18px;
            color: var(--accent);
        }

        .params-modal-close {
            background: none;
            border: none;
            font-size: 20px;
            cursor: pointer;
            color: var(--text-muted);
            padding: 4px;
            line-height: 1;
        }

        .params-modal-close:hover {
            color: var(--text-primary);
        }

        .params-modal-body {
            flex: 1;
            overflow-y: auto;
            padding: 20px;
        }

        .params-modal-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
        }

        .main {
            display: flex;
            flex-direction: row;
            flex: 1;
            overflow: hidden;
            height: 100%;
        }

        .sidebar {
            width: 300px;
            height: 100%;
            background: var(--bg-card);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            flex-shrink: 0;
        }

        .sidebar-header {
            padding: 16px;
            border-bottom: 1px solid var(--border);
        }

        .sidebar-title {
            font-size: 12px;
            font-weight: 600;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 12px;
        }

        .search-box {
            position: relative;
        }

        .search-box input {
            width: 100%;
            padding: 10px 12px 10px 34px;
            background: var(--bg-input);
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            color: var(--text-primary);
            font-size: 13px;
            transition: all 0.2s;
        }

        .search-box input:focus {
            outline: none;
            border-color: var(--accent);
            background: var(--bg-card);
        }

        .search-box svg {
            position: absolute;
            left: 10px;
            top: 50%;
            transform: translateY(-50%);
            width: 14px;
            height: 14px;
            color: var(--text-muted);
        }

        .sidebar-actions {
            display: flex;
            gap: 8px;
            margin-top: 12px;
        }

        .btn-ghost {
            flex: 1;
            padding: 8px;
            background: transparent;
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            color: var(--text-secondary);
            font-size: 12px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .btn-ghost:hover {
            background: var(--bg-hover);
            border-color: var(--border-light);
}

        .btn {
            padding: 10px 16px;
            border-radius: var(--radius-sm);
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            border: none;
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            line-height: 1.4;
        }

        .btn svg { width: 14px; height: 14px; }

        .btn-primary {
            background: var(--accent);
            color: white;
        }

        .btn-primary:hover { background: var(--accent-hover); }
        .btn-primary:disabled { opacity: 0.5; cursor: not-allowed; }

        .btn-secondary {
            background: var(--bg-input);
            border: 1px solid var(--border);
            color: var(--text-secondary);
        }

        .btn-secondary:hover {
            background: var(--bg-hover);
            border-color: var(--border-light);
        }

        .file-list {
            flex: 1;
            overflow-y: auto;
            padding: 12px;
        }

        .file-list::-webkit-scrollbar { width: 4px; }
        .file-list::-webkit-scrollbar-track { background: transparent; }
        .file-list::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }

        .group {
            margin-bottom: 6px;
            border-radius: var(--radius-sm);
            overflow: hidden;
            background: var(--bg-input);
        }

        .group-header {
            padding: 10px 12px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-weight: 500;
            font-size: 13px;
            color: var(--text-primary);
            transition: background 0.15s;
        }

        .group-header:hover {
            background: var(--bg-hover);
        }

        .group-name {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .group-count {
            font-size: 11px;
            padding: 2px 8px;
            background: var(--accent-bg);
            color: var(--accent);
            border-radius: 10px;
            font-weight: 500;
        }

        .group-chevron {
            transition: transform 0.2s;
            color: var(--text-muted);
        }

        .group.open .group-chevron { transform: rotate(180deg); }

        .group-files { display: none; padding: 0 8px 8px; }
        .group.open .group-files { display: block; }

        .file-item {
            padding: 8px 10px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 13px;
            border-radius: var(--radius-sm);
            transition: all 0.15s;
            margin-bottom: 2px;
        }

        .file-checkbox {
            width: 15px;
            height: 15px;
            border: 2px solid var(--border);
            border-radius: 4px;
            flex-shrink: 0;
            position: relative;
        }

        .file-checkbox.checked {
            background: var(--accent);
            border-color: var(--accent);
        }

        .file-checkbox.checked::after {
            content: '';
            position: absolute;
            left: 4px;
            top: 2px;
            width: 3px;
            height: 6px;
            border: solid white;
            border-width: 0 2px 2px 0;
            transform: rotate(45deg);
        }

        .file-item:hover { background: var(--bg-hover); }
        .file-item.selected { background: var(--accent-light); }

        .file-item input[type="checkbox"] {
            width: 15px;
            height: 15px;
            accent-color: var(--accent);
            cursor: pointer;
        }

        .file-info { flex: 1; min-width: 0; }

        .file-name {
            font-weight: 500;
            margin-bottom: 1px;
            color: var(--text-primary);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .file-source {
            font-size: 11px;
            color: var(--text-muted);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

.center-panel {
            flex: 1;
            display: flex;
            flex-direction: row;
            overflow: hidden;
            min-width: 0;
            align-items: stretch;
        }

        .content {
            flex: 1;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            min-width: 0;
            min-height: 0;
        }

        .config-panel {
            flex: 1;
            display: flex;
            flex-direction: column;
            min-width: 0;
            min-height: 0;
            overflow: hidden;
            background: var(--bg-card);
            border-right: 1px solid var(--border);
        }

        .panel-header {
            padding: 14px 18px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .panel-title {
            font-size: 15px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--text-primary);
        }

        .panel-title svg {
            width: 18px;
            height: 18px;
            color: var(--accent);
        }

        .result-badge {
            font-size: 11px;
            padding: 3px 8px;
            border-radius: 10px;
            background: var(--bg-input);
            color: var(--text-secondary);
        }

        .panel-body {
            flex: 1;
            overflow-y: auto;
            overflow-x: hidden;
            padding: 16px 18px;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .config-section {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .section-title {
            font-size: 11px;
            font-weight: 600;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding-bottom: 8px;
            margin-bottom: 8px;
            position: relative;
        }

        .section-title::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 15%;
            height: 2px;
            background: var(--accent);
        }

        .config-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .form-group label {
            font-size: 13px;
            color: var(--text-secondary);
            font-weight: 500;
        }

        .form-input {
            width: 100%;
            padding: 12px 14px;
            background: var(--bg-input);
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            color: var(--text-primary);
            font-size: 14px;
            transition: all 0.2s;
            font-family: inherit;
        }

        .form-input:focus {
            outline: none;
            border-color: var(--accent);
            background: var(--bg-card);
        }

        .slider-group {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .slider-label {
            font-size: 13px;
            color: var(--text-secondary);
            font-weight: 500;
        }

        .slider-row {
            display: flex;
            align-items: center;
            gap: 14px;
        }

.checkbox-row {
            display: flex;
            align-items: center;
            gap: 10px;
            padding-left: 2px;
            margin-top: 4.5px;
        }

        .checkbox-label {
            font-size: 17.5px;
            color: var(--text-secondary);
            font-weight: 380;
            margin-top: -0.5px;
        }

        input[type="checkbox"] {
            width: 18px;
            height: 18px;
            accent-color: var(--accent);
            cursor: pointer;
            margin-bottom: 1px;
        }

        input[type="range"] {
            -webkit-appearance: none;
            appearance: none;
            flex: 1;
            height: 6px;
            border-radius: 3px;
            background: var(--border);
            outline: none;
            cursor: pointer;
        }

        input[type="range"]::-webkit-slider-thumb {
            -webkit-appearance: none;
            width: 18px;
            height: 18px;
            border-radius: 50%;
            background: var(--accent);
            cursor: pointer;
        }

        .slider-input {
            width: 60px;
            padding: 8px 2px;
            background: var(--bg-input);
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            color: var(--text-primary);
            font-size: 13px;
            text-align: center;
        }

        .slider-input::-webkit-outer-spin-button,
        .slider-input::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }

        .slider-input[type=number] {
            -moz-appearance: textfield;
        }

        .slider-input:focus {
            outline: none;
            border-color: var(--accent);
        }

        .model-list {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-top: 8px;
        }

        .model-tag {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 4px 8px;
            background: var(--bg-input);
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            font-size: 11px;
        }

        .model-tag-order {
            width: 16px;
            height: 16px;
            background: var(--accent);
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 9px;
            font-weight: 600;
            flex-shrink: 0;
        }

        .model-tag-name {
            max-width: 120px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .result-section-header {
            padding: 14px 18px;
            border-top: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .progress-container {
            padding: 12px 18px;
            border-top: 1px solid var(--border);
        }

        .binding-section {
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .binding-box {
            display: flex;
            flex: 1;
            border-radius: var(--radius-md);
            overflow: hidden;
            min-height: 180px;
            background: var(--bg-card);
            box-shadow: var(--shadow-sm);
        }

        .binding-col {
            display: flex;
            flex-direction: column;
            flex: 1;
            min-width: 0;
        }

        .binding-col-header {
            padding: 6px 10px;
            font-size: 10px;
            font-weight: 600;
            color: var(--text-muted);
            text-transform: uppercase;
            background: var(--bg-card);
            flex-shrink: 0;
        }

        .binding-col-list {
            flex: 1;
            overflow-y: auto;
            padding: 6px;
            font-size: 11px;
            background: var(--bg-card);
        }

        .binding-col-canvas {
            flex: 1;
            background: var(--bg-card);
            min-height: 0;
        }

        .binding-item {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 6px 8px;
            border-radius: 4px;
            cursor: pointer;
            transition: all 0.15s;
            margin-bottom: 2px;
        }

        .binding-item:hover {
            background: var(--bg-hover);
        }

        .binding-item.selected {
            background: var(--accent-light);
        }

        .binding-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--border);
            flex-shrink: 0;
        }

        .binding-dot.connected {
            background: var(--accent);
        }

        .binding-name {
            flex: 1;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .binding-check {
            width: 12px;
            height: 12px;
            border: 2px solid var(--border);
            border-radius: 3px;
            flex-shrink: 0;
            position: relative;
        }

        .binding-check.checked {
            background: var(--accent);
            border-color: var(--accent);
        }

        .binding-check.checked::after {
            content: '';
            position: absolute;
            left: 2px;
            top: 0px;
            width: 3px;
            height: 5px;
            border: solid white;
            border-width: 0 1.5px 1.5px 0;
            transform: rotate(45deg);
        }

        .binding-canvas-area {
            flex: 1;
            display: flex;
            flex-direction: column;
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            overflow: hidden;
            min-width: 0;
        }

        .binding-canvas-header {
            padding: 8px 10px;
            font-size: 10px;
            font-weight: 600;
            color: var(--text-muted);
            text-transform: uppercase;
            background: var(--bg-input);
            border-bottom: 1px solid var(--border);
        }

        .binding-canvas {
            flex: 1;
            position: relative;
            background: var(--bg-page);
            min-height: 0;
        }

        .binding-svg {
            width: 100%;
            height: 100%;
        }

        .node-line {
            stroke: var(--accent);
            stroke-width: 2;
            fill: none;
            opacity: 0.6;
        }

        .node-circle {
            fill: var(--bg-card);
            stroke: var(--border);
            stroke-width: 2;
            cursor: pointer;
        }

        .node-circle:hover {
            stroke: var(--accent);
        }

        .node-circle.selected {
            fill: var(--accent-light);
            stroke: var(--accent);
        }

        .node-circle.source {
            fill: rgba(59, 130, 246, 0.15);
            stroke: var(--accent);
        }

        .node-text {
            font-size: 9px;
            fill: var(--text-secondary);
            text-anchor: middle;
        }

        .progress-bar {
            height: 4px;
            background: var(--border);
            border-radius: 2px;
            overflow: hidden;
        }

        .progress-fill {
            height: 100%;
            background: var(--accent);
            border-radius: 2px;
            transition: width 0.3s ease;
        }

        .progress-stats {
            display: flex;
            justify-content: space-between;
            margin-top: 4px;
            font-size: 10px;
            color: var(--text-secondary);
        }

        .action-bar {
            padding: 10px 18px;
            border-top: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .selected-info {
            font-size: 12px;
            color: var(--text-secondary);
        }

        .selected-info strong {
            color: var(--accent);
            font-weight: 600;
        }

        .action-buttons {
            display: flex;
            gap: 8px;
        }

        .result-list {
            flex: 1;
            overflow-y: auto;
            overflow-x: hidden;
            padding: 0;
        }

        .result-item {
            padding: 10px 14px;
            border-bottom: 1px solid var(--border);
        }

        .result-item:last-child { border-bottom: none; }
        .result-item:hover { background: var(--bg-hover); }

        .result-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 6px;
        }

        .result-id {
            font-weight: 600;
            font-size: 12px;
            color: var(--accent);
        }

        .result-source {
            font-size: 10px;
            color: var(--text-secondary);
            background: var(--bg-input);
            padding: 2px 6px;
            border-radius: 8px;
        }

        .result-row {
            margin-bottom: 4px;
        }

        .result-row:last-child { margin-bottom: 0; }

        .result-label {
            font-size: 10px;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.3px;
            font-weight: 500;
            margin-bottom: 2px;
        }

        .result-content {
            font-size: 11px;
            line-height: 1.5;
            padding: 8px 10px;
            background: var(--bg-input);
            border-radius: var(--radius-sm);
            border: 1px solid var(--border);
            white-space: pre-wrap;
            word-break: break-word;
        }

        .result-content.ai {
            border-color: var(--accent-light);
            background: var(--accent-bg);
        }

        .result-content.expected {
            border-color: #f59e0b;
            background: rgba(245, 158, 11, 0.08);
        }

        .empty-state {
            text-align: center;
            padding: 30px 20px;
            color: var(--text-secondary);
        }

        .empty-icon {
            font-size: 32px;
            margin-bottom: 10px;
            opacity: 0.4;
        }

        .empty-state p { font-size: 12px; }

        .streaming {
            animation: pulse 1.5s infinite;
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.4; }
        }

        .ai-stream-panel {
            width: 40%;
            background: var(--bg-card);
            border-left: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            flex-shrink: 0;
            overflow: hidden;
        }

        .ai-stream-header {
            flex-shrink: 0;
            padding: 14px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .ai-stream-content {
            flex: 1;
            overflow-y: auto;
            overflow-x: hidden;
            padding: 14px;
            min-height: 0;
            height: 0;
        }

        .result-label {
            font-size: 10px;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.3px;
            font-weight: 500;
            margin-bottom: 2px;
        }

        .result-content {
            font-size: 11px;
            line-height: 1.5;
            padding: 8px 10px;
            background: var(--bg-input);
            border-radius: var(--radius-sm);
            border: 1px solid var(--border);
            white-space: pre-wrap;
            word-break: break-word;
        }

        .result-content.expected {
            border-color: #f59e0b;
            background: rgba(245, 158, 11, 0.08);
        }

        .ai-stream-title {
            font-size: 13px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
            color: var(--text-primary);
        }

        .ai-stream-title svg {
            width: 16px;
            height: 16px;
            color: var(--accent);
        }

        .ai-stream-status {
            font-size: 10px;
            padding: 3px 8px;
            border-radius: 10px;
            background: var(--bg-input);
            color: var(--text-secondary);
        }

        .ai-stream-status.active {
            background: var(--accent-bg);
            color: var(--accent);
        }

        .ai-stream-content {
            flex: 1;
            overflow-y: auto;
            padding: 14px;
        }

        .ai-message {
            margin-bottom: 14px;
        }

        .ai-message:last-child { margin-bottom: 0; }

        .ai-message-header {
            display: flex;
            align-items: center;
            gap: 6px;
            margin-bottom: 6px;
        }

        .ai-message-label {
            font-size: 10px;
            font-weight: 600;
            color: var(--text-muted);
            text-transform: uppercase;
        }

        .ai-message-time {
            font-size: 10px;
            color: var(--text-muted);
        }

        .ai-message-content {
            font-size: 12px;
            line-height: 1.6;
            padding: 10px 12px;
            background: var(--bg-input);
            border-radius: var(--radius-sm);
            border: 1px solid var(--border);
            color: var(--text-primary);
            white-space: pre-wrap;
            word-break: break-word;
        }

        .ai-message-content.streaming {
            border-color: var(--accent-light);
            background: var(--accent-bg);
        }

        .ai-empty {
            text-align: center;
            padding: 40px 20px;
            color: var(--text-muted);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100%;
            min-height: 300px;
        }

        .ai-empty-icon {
            font-size: 48px;
            margin-bottom: 16px;
            opacity: 0.4;
        }

        .ai-empty p {
            font-size: 14px;
            color: var(--text-secondary);
        }

        @media (max-width: 1200px) {
            .ai-stream-panel { display: none; }
        }

        @media (max-width: 768px) {
            .main { flex-direction: column; }
            .sidebar { width: 100%; height: auto; max-height: 200px; }
            .content { padding: 12px; }
            .config-grid { grid-template-columns: 1fr; }
        }

        .model-modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.5);
            z-index: 1000;
            align-items: center;
            justify-content: center;
        }

        .model-modal-overlay.show {
            display: flex;
        }

        .model-modal {
            background: var(--bg-card);
            border-radius: var(--radius-lg);
            width: 90%;
            max-width: 500px;
            max-height: 80vh;
            display: flex;
            flex-direction: column;
            box-shadow: var(--shadow-lg);
        }

        .model-modal-header {
            padding: 16px 20px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .model-modal-title {
            font-size: 16px;
            font-weight: 600;
        }

        .model-modal-close {
            background: none;
            border: none;
            font-size: 20px;
            cursor: pointer;
            color: var(--text-muted);
            padding: 4px;
            line-height: 1;
        }

        .model-modal-close:hover {
            color: var(--text-primary);
        }

        .model-modal-body {
            flex: 1;
            overflow-y: auto;
            padding: 16px 20px;
        }

        .model-checkbox-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 12px;
            border-radius: var(--radius-sm);
            cursor: pointer;
            transition: background 0.15s;
        }

        .model-checkbox-item:hover {
            background: var(--bg-hover);
        }

        .model-order-badge {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: var(--bg-input);
            color: var(--text-muted);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 600;
            flex-shrink: 0;
            border: 2px solid var(--border-light);
        }

        .model-order-badge.active {
            background: var(--accent);
            color: white;
            border: 2px solid var(--accent);
        }
        }

        .model-name {
            flex: 1;
            font-size: 14px;
        }

        .model-modal-footer {
            padding: 16px 20px;
            border-top: 1px solid var(--border);
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }

        .binding-panel {
            flex: 1;
            display: flex;
            flex-direction: column;
            min-height: 0;
            overflow: hidden;
            background: var(--bg-card);
            border-top: 1px solid var(--border);
        }

        .binding-body {
            flex: 1;
            display: flex;
            overflow: hidden;
            min-height: 0;
        }

        .binding-list-panel {
            width: 200px;
            display: flex;
            flex-direction: column;
            border-right: 1px solid var(--border);
            flex-shrink: 0;
        }

        .binding-list-header {
            padding: 8px 12px;
            font-size: 11px;
            font-weight: 600;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            background: var(--bg-input);
            border-bottom: 1px solid var(--border);
            flex-shrink: 0;
        }

        .binding-list {
            flex: 1;
            overflow-y: auto;
            padding: 8px;
        }

        .binding-item {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 10px;
            border-radius: var(--radius-sm);
            cursor: pointer;
            transition: all 0.15s;
            margin-bottom: 4px;
            font-size: 12px;
        }

        .binding-item:hover {
            background: var(--bg-hover);
        }

        .binding-item.selected {
            background: var(--accent-light);
        }

        .binding-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--border);
            flex-shrink: 0;
        }

        .binding-dot.connected {
            background: var(--accent);
        }

        .binding-item-name {
            flex: 1;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .binding-check {
            width: 14px;
            height: 14px;
            border: 2px solid var(--border);
            border-radius: 3px;
            flex-shrink: 0;
            position: relative;
        }

        .binding-check.checked {
            background: var(--accent);
            border-color: var(--accent);
        }

        .binding-check.checked::after {
            content: '';
            position: absolute;
            left: 3px;
            top: 1px;
            width: 3px;
            height: 6px;
            border: solid white;
            border-width: 0 2px 2px 0;
            transform: rotate(45deg);
        }

        .binding-canvas-area {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            min-width: 0;
        }

        .binding-canvas-header {
            padding: 8px 12px;
            font-size: 11px;
            font-weight: 600;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            background: var(--bg-card);
            border-bottom: 1px solid var(--border);
            flex-shrink: 0;
        }

        .binding-canvas {
            flex: 1;
            position: relative;
            overflow: hidden;
            background: var(--bg-page);
        }

        .binding-svg {
            width: 100%;
            height: 100%;
        }

        .node-line {
            stroke: var(--accent);
            stroke-width: 2;
            fill: none;
            opacity: 0.6;
        }

        .node-line:hover {
            opacity: 1;
            stroke-width: 3;
            cursor: pointer;
        }

        .node-circle {
            fill: var(--bg-card);
            stroke: var(--border);
            stroke-width: 2;
            cursor: pointer;
            transition: all 0.2s;
        }

        .node-circle:hover {
            stroke: var(--accent);
            stroke-width: 3;
        }

        .node-circle.selected {
            fill: var(--accent-light);
            stroke: var(--accent);
        }

        .node-circle.source {
            fill: rgba(59, 130, 246, 0.15);
            stroke: var(--accent);
        }

        .node-text {
            font-size: 10px;
            fill: var(--text-secondary);
            text-anchor: middle;
            pointer-events: none;
        }

        .tab-header {
            display: flex;
            border-bottom: 1px solid var(--border);
            background: var(--bg-card);
        }

        .tab-btn {
            flex: 1;
            padding: 10px 12px;
            background: transparent;
            border: none;
            border-bottom: 2px solid transparent;
            color: var(--text-secondary);
            font-size: 12px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s;
        }

        .tab-btn:hover {
            color: var(--text-primary);
            background: var(--bg-hover);
        }

        .tab-btn.active {
            color: var(--accent);
            border-bottom-color: var(--accent);
        }

        .sidebar-content {
            flex: 1;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        .tab-panel {
            display: none;
            flex: 1;
            overflow: hidden;
            flex-direction: column;
        }

        .tab-panel.active {
            display: flex;
        }

        .binding-canvas {
            flex: 1;
            display: flex;
            flex-direction: column;
            background: var(--bg-card);
            border-left: 1px solid var(--border);
            overflow: hidden;
        }

        .binding-header {
            padding: 14px 18px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-shrink: 0;
        }

        .binding-title {
            font-size: 15px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .binding-title svg {
            width: 18px;
            height: 18px;
            color: var(--accent);
        }

        .binding-body {
            flex: 1;
            display: flex;
            overflow: hidden;
        }

        .binding-panel {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            min-width: 0;
        }

        .binding-panel-left {
            border-right: 1px solid var(--border);
        }

        .binding-panel-header {
            padding: 10px 14px;
            font-size: 11px;
            font-weight: 600;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            background: var(--bg-input);
            border-bottom: 1px solid var(--border);
            flex-shrink: 0;
        }

        .binding-list {
            flex: 1;
            overflow-y: auto;
            padding: 8px;
        }

        .binding-item {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 10px;
            border-radius: var(--radius-sm);
            cursor: pointer;
            transition: all 0.15s;
            margin-bottom: 4px;
            font-size: 12px;
        }

        .binding-item:hover {
            background: var(--bg-hover);
        }

        .binding-item.selected {
            background: var(--accent-light);
        }

        .binding-item-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--border);
            flex-shrink: 0;
        }

        .binding-item-dot.connected {
            background: var(--accent);
        }

        .binding-item-name {
            flex: 1;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .binding-item-check {
            width: 14px;
            height: 14px;
            border: 2px solid var(--border);
            border-radius: 3px;
            flex-shrink: 0;
            position: relative;
        }

        .binding-item-check.checked {
            background: var(--accent);
            border-color: var(--accent);
        }

        .binding-item-check.checked::after {
            content: '';
            position: absolute;
            left: 3px;
            top: 1px;
            width: 3px;
            height: 6px;
            border: solid white;
            border-width: 0 2px 2px 0;
            transform: rotate(45deg);
        }

        .connection-area {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            min-width: 0;
            background: var(--bg-page);
        }

        .connection-header {
            padding: 10px 14px;
            font-size: 11px;
            font-weight: 600;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            background: var(--bg-card);
            border-bottom: 1px solid var(--border);
            flex-shrink: 0;
        }

        .connection-canvas {
            flex: 1;
            position: relative;
            overflow: hidden;
        }

        .connection-svg {
            width: 100%;
            height: 100%;
        }

        .connection-line {
            stroke: var(--accent);
            stroke-width: 2;
            fill: none;
            opacity: 0.6;
        }

        .connection-line:hover {
            opacity: 1;
            stroke-width: 3;
            cursor: pointer;
        }

        .node-circle {
            fill: var(--bg-card);
            stroke: var(--border);
            stroke-width: 2;
            cursor: pointer;
            transition: all 0.2s;
        }

        .node-circle:hover {
            stroke: var(--accent);
            stroke-width: 3;
        }

        .node-circle.selected {
            fill: var(--accent-light);
            stroke: var(--accent);
        }

        .node-circle.source {
            fill: rgba(59, 130, 246, 0.1);
        }

        .node-label {
            font-size: 10px;
            fill: var(--text-secondary);
            text-anchor: middle;
            pointer-events: none;
        }

        .connection-empty {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100%;
            color: var(--text-muted);
            font-size: 12px;
            text-align: center;
            padding: 20px;
        }

        .connection-empty-icon {
            font-size: 32px;
            margin-bottom: 10px;
            opacity: 0.4;
        }

        .prompt-item {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 10px;
            border-radius: var(--radius-sm);
            cursor: pointer;
            transition: all 0.15s;
            margin-bottom: 4px;
            font-size: 12px;
        }

        .prompt-item:hover {
            background: var(--bg-hover);
        }

        .prompt-item.selected {
            background: var(--accent-light);
        }

        .prompt-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--accent);
            flex-shrink: 0;
        }

        .prompt-name {
            flex: 1;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
    </style>
</head>
<body>
    <header class="header">
        <div class="header-brand">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
            </svg>
            AI系统提示词测试
        </div>
        <span class="header-badge">v1.0</span>
    </header>
    
    <main class="main">
        <aside class="sidebar">
            <div class="sidebar-header">
                <div class="sidebar-title">测试文件</div>
                <div class="search-box">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"/>
                        <path d="M21 21l-4.35-4.35"/>
                    </svg>
                    <input type="text" id="searchInput" placeholder="搜索文件..." oninput="renderFileList()">
                </div>
                <div class="sidebar-actions">
                    <button class="btn-ghost" onclick="selectAll()">全选</button>
                    <button class="btn-ghost" onclick="selectNone()">清除</button>
                </div>
            </div>
            <div class="file-list" id="fileList"></div>
        </aside>
        
        <div class="center-panel">
            <div class="content">
                <div class="config-panel">
                    <div class="panel-header">
                        <div class="panel-title">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="3"/>
                                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
                            </svg>
                            配置参数
                        </div>
                        <span class="result-badge" id="resultCount">0 题</span>
                    </div>
                    <div class="panel-body">
                        <div class="config-section">
                            <div class="section-title">路径设置</div>
                            <div class="config-grid">
                                <div class="form-group">
                                    <label>测试集目录</label>
                                    <input type="text" class="form-input" id="testSetDir" placeholder="D:/测试集" onblur="onConfigChange()">
                                </div>
                            </div>
                        </div>
                        <div class="config-section">
                            <div class="section-title">模型配置</div>
                            <div class="config-grid">
                                <div class="form-group">
                                    <label>API Key</label>
                                    <input type="password" class="form-input" id="apiKey" placeholder="输入您的 API Key" onblur="onConfigChange()">
                                    <button class="settings-toggle" style="margin-top:8px;width:100%;justify-content:center" id="paramsToggle" onclick="toggleParamsModal()">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <circle cx="12" cy="12" r="3"/>
                                            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
                                        </svg>
                                        生成参数
                                    </button>
                                </div>
                                <div class="form-group">
                                    <label>Base URL</label>
                                    <input type="text" class="form-input" id="baseUrl" placeholder="https://api.openai.com" onblur="onConfigChange()">
                                </div>
                                <div class="form-group">
                                    <label>模型</label>
                                    <button class="btn btn-secondary" id="openModelBtn" onclick="openModelModal()">选择模型 (<span id="selectedModelCount" style="position:relative;top:0.5px">0</span>)</button>
                                    <div class="model-list" id="modelList" style="display:none"></div>
                                    <div style="display:flex;gap:8px;margin-top:12px">
                                        <button class="btn btn-primary" id="runBtn" onclick="runTests()" style="flex:1">开始测试</button>
                                        <button class="btn btn-secondary" id="stopBtn" onclick="stopTests()" style="flex:1" disabled>终止测试</button>
                                    </div>
                                </div>
                            </div>
                        <div class="progress-container" id="progressContainer" style="display:none;">
                            <div class="progress-bar">
                                <div class="progress-fill" id="progressFill" style="width:0%"></div>
                            </div>
                            <div class="progress-stats">
                                <span id="progressText">准备中...</span>
                                <span id="progressPercent">0%</span>
                            </div>
                        </div>
                        <div class="binding-section">
                            <div class="panel-header">
                                <div class="panel-title">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                                        <polyline points="15 3 21 3 21 9"/>
                                        <line x1="10" y1="14" x2="21" y2="3"/>
                                    </svg>
                                    关联管理
                                </div>
                                <button class="btn btn-primary" onclick="saveBindings()" style="padding:5px 10px;font-size:11px">保存</button>
                            </div>
                            <div class="binding-box">
                                <div class="binding-col">
                                    <div class="binding-col-header">系统提示</div>
                                    <div class="binding-col-list" id="systemPromptList"></div>
                                </div>
                                <div class="binding-col binding-col-center">
                                    <div class="binding-col-header">关联可视化</div>
                                    <div class="binding-col-canvas" id="bindingCanvas">
                                        <svg class="binding-svg" id="bindingSvg"></svg>
                                    </div>
                                </div>
                                <div class="binding-col">
                                    <div class="binding-col-header">已选测试 (<span id="selectedTestCount">0</span>)</div>
                                    <div class="binding-col-list" id="selectedTestList"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <aside class="ai-stream-panel">
            <div class="ai-stream-header">
                <div class="ai-stream-title">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                    </svg>
                    AI 回复预览
                </div>
                <span class="ai-stream-status" id="aiStreamStatus">等待中</span>
            </div>
            <div class="ai-stream-content" id="aiStreamContent">
                <div class="ai-empty">
                    <div class="ai-empty-icon">💭</div>
                    <p>开始测试后，这里将显示AI的实时回复</p>
                </div>
            </div>
        </aside>
    </main>

    <div class="params-modal-overlay" id="paramsModal">
        <div class="params-modal">
            <div class="params-modal-header">
                <div class="params-modal-title">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="3"/>
                        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
                    </svg>
                    生成参数
                </div>
                <button class="params-modal-close" onclick="toggleParamsModal()">&times;</button>
            </div>
                <div class="params-modal-body">
                    <div class="params-modal-grid">
                        <div class="slider-group">
                            <div class="slider-label">温度</div>
                            <div class="slider-row">
                                <input type="range" id="modal-temperature" step="0.05" min="0" max="2" value="0.6" oninput="onModalSliderChange('temperature', this.value)">
                                <input type="number" class="slider-input" id="modal-temperatureInput" step="0.05" min="0" max="2" value="0.6" onchange="onModalNumberChange('temperature', this.value)">
                            </div>
                        </div>
                        <div class="slider-group">
                            <div class="slider-label">并发数</div>
                            <div class="slider-row">
                                <input type="range" id="modal-concurrency" step="1" min="1" max="10" value="1" oninput="onModalSliderChange('concurrency', this.value)">
                                <input type="number" class="slider-input" id="modal-concurrencyInput" step="1" min="1" max="10" value="1" onchange="onModalNumberChange('concurrency', this.value)">
                            </div>
                        </div>
                        <div class="slider-group">
                            <div class="slider-label">测试次数</div>
                            <div class="slider-row">
                                <input type="range" id="modal-testCount" step="1" min="1" max="10" value="1" oninput="onModalSliderChange('testCount', this.value)">
                                <input type="number" class="slider-input" id="modal-testCountInput" step="1" min="1" max="10" value="1" onchange="onModalNumberChange('testCount', this.value)">
                            </div>
                        </div>
                        <div class="slider-group">
                            <div class="slider-label">最大重试</div>
                            <div class="slider-row">
                                <input type="range" id="modal-maxRetries" step="1" min="1" max="10" value="3" oninput="onModalSliderChange('maxRetries', this.value)">
                                <input type="number" class="slider-input" id="modal-maxRetriesInput" step="1" min="1" max="10" value="3" onchange="onModalNumberChange('maxRetries', this.value)">
                            </div>
                        </div>
                        <div class="slider-group">
                            <div class="slider-label">上下文大小</div>
                            <div class="slider-row">
                                <input type="range" id="modal-contextSize" step="1024" min="0" max="128000" value="32767" oninput="onModalSliderChange('contextSize', this.value)">
                                <input type="number" class="slider-input" id="modal-contextSizeInput" step="1024" min="0" max="128000" value="32767" onchange="onModalNumberChange('contextSize', this.value)">
                            </div>
                        </div>
                        <div class="slider-group">
                            <div class="slider-label">Top-P</div>
                            <div class="slider-row">
                                <input type="range" id="modal-topP" step="0.05" min="0" max="1" value="0.95" oninput="onModalSliderChange('topP', this.value)">
                                <input type="number" class="slider-input" id="modal-topPInput" step="0.05" min="0" max="1" value="0.95" onchange="onModalNumberChange('topP', this.value)">
                            </div>
                        </div>
                        <div class="slider-group">
                            <div class="slider-label">Min-P</div>
                            <div class="slider-row">
                                <input type="range" id="modal-minP" step="0.05" min="0" max="1" value="0.01" oninput="onModalSliderChange('minP', this.value)">
                                <input type="number" class="slider-input" id="modal-minPInput" step="0.05" min="0" max="1" value="0.01" onchange="onModalNumberChange('minP', this.value)">
                            </div>
                        </div>
                        <div class="slider-group">
                            <div class="slider-label">Top-K</div>
                            <div class="slider-row">
                                <input type="range" id="modal-topK" step="1" min="1" max="100" value="40" oninput="onModalSliderChange('topK', this.value)">
                                <input type="number" class="slider-input" id="modal-topKInput" step="1" min="1" max="100" value="40" onchange="onModalNumberChange('topK', this.value)">
                            </div>
                        </div>
                        <div class="slider-group">
                            <div class="slider-label">刷新模型</div>
                            <button class="btn btn-secondary" style="width:100%" onclick="refreshModels()">刷新模型列表</button>
                        </div>
                        <div class="slider-group">
                            <div class="slider-label">流式传输</div>
                            <div class="checkbox-row">
                                <input type="checkbox" id="modal-streaming" checked onchange="onModalConfigChange()">
                                <span class="checkbox-label">启用流式输出</span>
                            </div>
                        </div>
                    </div>
                    <div class="progress-container" id="progressContainer" style="display:none;">
                        <div class="progress-bar">
                            <div class="progress-fill" id="progressFill" style="width:0%"></div>
                        </div>
                        <div class="progress-stats">
                            <span id="progressText">准备中...</span>
                            <span id="progressPercent">0%</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <div class="model-modal-overlay" id="modelModal">
        <div class="model-modal">
            <div class="model-modal-header">
                <span class="model-modal-title">选择模型</span>
                <button class="model-modal-close" onclick="closeModelModal()">&times;</button>
            </div>
            <div class="model-modal-body" id="modelCheckboxList"></div>
            <div class="model-modal-footer">
                <button class="btn btn-secondary" onclick="closeModelModal()">取消</button>
                <button class="btn btn-primary" onclick="confirmModelSelection()">确定</button>
            </div>
        </div>
    </div>

    <script>
        let uiConfig = null;
        let selectedFiles = new Set();
        let allResults = {};
        let selectedModels = [];
        let availableModels = [];
        let openGroups = new Set();
        let abortController = null;
        let isRunning = false;
        let systemPrompts = [];
        let questionGroups = {};
        let bindings = {};
        let selectedSystemPrompt = null;

        async function init() {
            await loadConfig();
            await loadUIConfig();
            updateSelectedModelCount();
            await loadBindings();
            loadSystemPrompts();
            loadQuestionGroups();
            renderBindings();
        }

        function updateModalSliderDisplay(id, value) {
            const slider = document.getElementById('modal-' + id);
            const input = document.getElementById('modal-' + id + 'Input');
            if (slider) slider.value = value;
            if (input) input.value = parseFloat(value).toFixed(id === 'temperature' || id === 'topP' ? 1 : 0);
        }

        function onModalSliderChange(id, value) {
            updateModalSliderDisplay(id, value);
            onConfigChange();
        }

        function onModalNumberChange(id, value) {
            let num = parseFloat(value);
            const slider = document.getElementById('modal-' + id);
            if (slider) {
                const min = parseFloat(slider.min);
                const max = parseFloat(slider.max);
                num = Math.min(max, Math.max(min, num));
            }
            updateModalSliderDisplay(id, num);
            onConfigChange();
        }

        async function loadBindings() {
            try {
                const response = await fetch('/api/v1/bindings');
                bindings = await response.json();
                renderBindings();
            } catch (error) {
                console.error('Failed to load bindings:', error);
            }
        }

        async function loadSystemPrompts() {
            try {
                const response = await fetch('/api/v1/system-prompts');
                systemPrompts = await response.json();
                renderSystemPromptList();
            } catch (error) {
                console.error('Failed to load system prompts:', error);
            }
        }

        async function loadQuestionGroups() {
            try {
                const response = await fetch('/api/v1/question-groups');
                questionGroups = await response.json();
                renderQuestionGroupList();
            } catch (error) {
                console.error('Failed to load question groups:', error);
            }
        }

        function renderSystemPromptList() {
            const container = document.getElementById('systemPromptList');
            if (!systemPrompts || systemPrompts.length === 0) {
                container.innerHTML = '<div class="empty-state"><p>暂无系统提示</p></div>';
                return;
            }
            container.innerHTML = systemPrompts.map((prompt, index) => `
                <div class="binding-item ${selectedSystemPrompt === prompt.name ? 'selected' : ''}" onclick="selectSystemPrompt('${prompt.name}')">
                    <span class="binding-dot ${bindings[prompt.name] ? 'connected' : ''}"></span>
                    <span class="binding-item-name">${prompt.name}</span>
                    <span class="binding-check ${selectedSystemPrompt === prompt.name ? 'checked' : ''}"></span>
                </div>
            `).join('');
        }

        function renderSelectedTestList() {
            const container = document.getElementById('selectedTestList');
            if (!selectedFiles || selectedFiles.size === 0) {
                container.innerHTML = '<div class="empty-state"><p>请先在左侧选择测试文件</p></div>';
                return;
            }
            document.getElementById('selectedTestCount').textContent = selectedFiles.size;
            const fileArray = Array.from(selectedFiles);
            container.innerHTML = fileArray.map(fileKey => {
                const name = fileKey.split('|')[0].split('/').pop();
                const isConnected = bindings[selectedSystemPrompt] && bindings[selectedSystemPrompt].includes(fileKey);
                return `
                    <div class="binding-item" onclick="event.stopPropagation();toggleTestBinding('${fileKey.replace(/'/g, "\\'")}')">
                        <span class="binding-dot ${isConnected ? 'connected' : ''}"></span>
                        <span class="binding-item-name">${name}</span>
                        <span class="binding-check ${isConnected ? 'checked' : ''}"></span>
                    </div>
                `;
            }).join('');
        }

        function selectSystemPrompt(name) {
            selectedSystemPrompt = name;
            renderSystemPromptList();
            renderSelectedTestList();
            renderBindingCanvas();
        }

        function toggleTestBinding(fileKey) {
            if (!selectedSystemPrompt) {
                alert('请先选择一个系统提示');
                return;
            }
            if (!bindings[selectedSystemPrompt]) {
                bindings[selectedSystemPrompt] = [];
            }
            const idx = bindings[selectedSystemPrompt].indexOf(fileKey);
            if (idx !== -1) {
                bindings[selectedSystemPrompt].splice(idx, 1);
            } else {
                bindings[selectedSystemPrompt].push(fileKey);
            }
            renderSelectedTestList();
            renderBindingCanvas();
        }

        function renderBindingCanvas() {
            const svg = document.getElementById('bindingSvg');
            const container = document.getElementById('bindingCanvas');
            
            if (!selectedSystemPrompt || selectedFiles.size === 0) {
                svg.innerHTML = `
                    <text x="50%" y="50%" text-anchor="middle" fill="#718096" font-size="12">
                        选择系统提示和测试文件查看关联
                    </text>
                `;
                return;
            }
            
            const connectedTests = bindings[selectedSystemPrompt] || [];
            const testFiles = Array.from(selectedFiles);
            
            const width = container.clientWidth || 300;
            const height = container.clientHeight || 200;
            const centerX = width / 2;
            const centerY = height / 2;
            
            let svgContent = '';
            
            testFiles.forEach((fileKey, index) => {
                const angle = (index / testFiles.length) * 2 * Math.PI - Math.PI / 2;
                const radius = Math.min(width, height) / 3;
                const x = centerX + radius * Math.cos(angle);
                const y = centerY + radius * Math.sin(angle);
                const isConnected = connectedTests.includes(fileKey);
                const name = fileKey.split('|')[0].split('/').pop().substring(0, 6);
                
                svgContent += `<circle cx="${x}" cy="${y}" r="20" class="node-circle ${isConnected ? 'selected' : ''}"/>`;
                svgContent += `<text x="${x}" y="${y + 4}" class="node-text">${name}</text>`;
                
                if (isConnected) {
                    svgContent += `<line x1="${centerX}" y1="${centerY}" x2="${x}" y2="${y}" class="node-line"/>`;
                }
            });
            
            svgContent += `<circle cx="${centerX}" cy="${centerY}" r="25" class="node-circle source"/>`;
            svgContent += `<text x="${centerX}" y="${centerY + 4}" class="node-text" font-weight="600">${selectedSystemPrompt.substring(0, 6)}</text>`;
            
            svg.innerHTML = svgContent;
        }

        function renderBindings() {
            renderSystemPromptList();
            renderSelectedTestList();
            renderBindingCanvas();
            updateSelectedTestCount();
        }

        function updateSelectedTestCount() {
            document.getElementById('selectedTestCount').textContent = selectedFiles.size;
        }

        async function saveBindings() {
            try {
                await fetch('/api/v1/bindings', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ bindings: bindings })
                });
                alert('关联关系已保存');
            } catch (error) {
                alert('保存失败: ' + error.message);
            }
        }

        function renderBindings() {
            renderSystemPromptList();
            renderSelectedTestList();
            renderBindingCanvas();
            updateSelectedTestCount();
        }

        function renderBindingCanvas() {
            const svg = document.getElementById('bindingSvg');
            const container = document.getElementById('connectionCanvas');
            
            if (!selectedSystemPrompt || Object.keys(questionGroups).length === 0) {
                svg.innerHTML = `
                    <text x="50%" y="50%" text-anchor="middle" fill="#718096" font-size="12">
                        选择系统提示查看关联关系
                    </text>
                `;
                return;
            }
            
            const connectedGroups = bindings[selectedSystemPrompt] || [];
            const groupKeys = Object.keys(questionGroups);
            
            const width = container.clientWidth || 400;
            const height = container.clientHeight || 300;
            const centerX = width / 2;
            const centerY = height / 2;
            const radius = Math.min(width, height) / 3;
            
            let lines = '';
            groupKeys.forEach((key, index) => {
                const angle = (index / groupKeys.length) * 2 * Math.PI - Math.PI / 2;
                const x = centerX + radius * Math.cos(angle);
                const y = centerY + radius * Math.sin(angle);
                const isConnected = connectedGroups.includes(key);
                lines += `
                    <circle cx="${x}" cy="${y}" r="20" class="node-circle ${isConnected ? 'selected' : ''}" fill="${isConnected ? 'rgba(59,130,246,0.2)' : '#fff'}"/>
                    <text x="${x}" y="${y + 3}" class="node-label">${questionGroups[key].name.substring(0, 4)}</text>
                `;
                if (isConnected) {
                    lines += `<line x1="${centerX}" y1="${centerY}" x2="${x}" y2="${y}" class="connection-line"/>`;
                }
            });
            
            lines += `<circle cx="${centerX}" cy="${centerY}" r="25" class="node-circle source" fill="rgba(59,130,246,0.15)" stroke="#3b82f6"/>`;
            lines += `<text x="${centerX}" y="${centerY + 4}" class="node-label" font-weight="600">${selectedSystemPrompt.substring(0, 6)}</text>`;
            
            svg.innerHTML = lines;
        }

        function renderFileList() {
            const container = document.getElementById('fileList');
            if (!uiConfig || !uiConfig.formatGroups) {
                container.innerHTML = '<div class="empty-state"><div class="empty-icon">📁</div><p>暂无测试文件</p></div>';
                return;
            }
            
            const searchText = document.getElementById('searchInput').value.toLowerCase();
            
            container.innerHTML = uiConfig.formatGroups.map((group, index) => {
                const filteredFiles = (group.files || []).filter(file => {
                    if (!searchText) return true;
                    const showName = file.source.split('/').pop().toLowerCase();
                    return showName.includes(searchText);
                });
                
                if (filteredFiles.length === 0) return '';
                
                return `
                <div class="group ${openGroups.has(index) ? 'open' : ''}" id="group-${index}">
                    <div class="group-header" onclick="toggleGroup(${index})">
                        <span class="group-name">
                            ${group.name}
                            <span class="group-count">${filteredFiles.length}</span>
                        </span>
                        <svg class="group-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="6 9 12 15 18 9"/>
                        </svg>
                    </div>
                    <ul class="group-files">
                        ${filteredFiles.map(file => {
                            const fileKey = `${file.source}|${file.testQuestion}`;
                            return `
                            <li class="file-item ${selectedFiles.has(fileKey) ? 'selected' : ''}" onclick="toggleFile('${fileKey}')">
                                <span class="file-checkbox ${selectedFiles.has(fileKey) ? 'checked' : ''}"></span>
                                <div class="file-info">
                                    <div class="file-name">${file.source.split('/').pop()}</div>
                                    <div class="file-source">${file.testQuestion}</div>
                                </div>
                            </li>
                            `;
                        }).join('')}
                    </ul>
                </div>
                `;
            }).join('');
        }

        async function loadConfig() {
            try {
                const response = await fetch('/api/v1/config');
                const config = await response.json();
                document.getElementById('testSetDir').value = config.test_set_dir || '';
                document.getElementById('apiKey').value = config.api_key || '';
                document.getElementById('baseUrl').value = config.base_url || '';
                updateModalSliderDisplay('temperature', config.temperature || 0.7);
                updateModalSliderDisplay('concurrency', config.concurrency || 1);
                updateModalSliderDisplay('testCount', config.test_count || 1);
                updateModalSliderDisplay('maxRetries', config.max_retries || 3);
                updateModalSliderDisplay('contextSize', config.context_size || 0);
                updateModalSliderDisplay('topP', config.top_p || 1.0);
                updateModalSliderDisplay('topK', config.top_k || 40);
                updateModalSliderDisplay('minP', config.min_p || 0.05);
                const modalStreamingCheckbox = document.getElementById('modal-streaming');
                if (modalStreamingCheckbox) modalStreamingCheckbox.checked = config.streaming !== false;
                if (config.api_key) {
                    await loadModels();
                }
            } catch (error) {
                console.error('Failed to load config:', error);
            }
        }

        function onModalConfigChange() {
            const config = {
                test_set_dir: document.getElementById('testSetDir').value,
                api_key: document.getElementById('apiKey').value,
                base_url: document.getElementById('baseUrl').value,
                models: selectedModels,
                temperature: parseFloat(document.getElementById('modal-temperature').value),
                concurrency: parseInt(document.getElementById('modal-concurrency').value),
                test_count: parseInt(document.getElementById('modal-testCount').value),
                max_retries: parseInt(document.getElementById('modal-maxRetries').value),
                context_size: parseInt(document.getElementById('modal-contextSize').value),
                streaming: document.getElementById('modal-streaming').checked,
                top_p: parseFloat(document.getElementById('modal-topP').value),
                top_k: parseInt(document.getElementById('modal-topK').value),
                min_p: parseFloat(document.getElementById('modal-minP').value)
            };
            fetch('/api/v1/config', { 
                method: 'POST', 
                headers: { 'Content-Type': 'application/json' }, 
                body: JSON.stringify(config) 
            });
        }

        function toggleParamsModal() {
            const btn = document.getElementById('paramsToggle');
            const modal = document.getElementById('paramsModal');
            if (modal.classList.contains('show')) {
                btn.classList.remove('active');
                modal.classList.remove('show');
            } else {
                syncModalFromMain();
                btn.classList.add('active');
                modal.classList.add('show');
            }
        }

        document.getElementById('paramsModal').addEventListener('click', function(e) {
            if (e.target === this) {
                toggleParamsModal();
            }
        });

        function syncModalFromMain() {
        }

        async function loadUIConfig() {
            try {
                const response = await fetch('/api/v1/ui-config');
                uiConfig = await response.json();
                renderFileList();
            } catch (error) {
                console.error('Failed to load UI config:', error);
            }
        }

        function openModelModal() {
            const apiKey = document.getElementById('apiKey').value;
            fetch('/api/v1/models', { 
                method: 'POST', 
                headers: { 'Content-Type': 'application/json' }, 
                body: JSON.stringify({ api_key: apiKey }) 
            })
            .then(res => {
                if (!res.ok) {
                    return res.text().then(text => {
                        throw new Error('API错误: ' + res.status + ' - ' + text);
                    });
                }
                return res.json();
            })
            .then(models => {
                availableModels = models.map(m => m.id);
                renderModelCheckboxList();
                document.getElementById('modelModal').classList.add('show');
            })
            .catch(error => {
                console.error('Failed to load models:', error);
                alert('加载模型失败: ' + error.message);
            });
        }

        function refreshModels() {
            const apiKey = document.getElementById('apiKey').value;
            fetch('/api/v1/models', { 
                method: 'POST', 
                headers: { 'Content-Type': 'application/json' }, 
                body: JSON.stringify({ api_key: apiKey }) 
            })
            .then(res => {
                if (!res.ok) {
                    return res.text().then(text => {
                        throw new Error('API错误: ' + res.status + ' - ' + text);
                    });
                }
                return res.json();
            })
            .then(models => {
                availableModels = models.map(m => m.id);
                alert('模型列表已刷新，共 ' + availableModels.length + ' 个模型');
            })
            .catch(error => {
                console.error('Failed to refresh models:', error);
                alert('刷新模型失败: ' + error.message);
            });
        }

        function confirmModelSelection() {
            updateSelectedModelCount();
            closeModelModal();
            onConfigChange();
        }

        function closeModelModal() {
            document.getElementById('modelModal').classList.remove('show');
        }

        function renderModelCheckboxList() {
            const container = document.getElementById('modelCheckboxList');
            container.innerHTML = availableModels.map(model => {
                const index = selectedModels.indexOf(model);
                const orderNum = index !== -1 ? index + 1 : null;
                return `
                <div class="model-checkbox-item" onclick="toggleModelSelection('${model}')">
                    <span class="model-order-badge ${orderNum ? 'active' : ''}">${orderNum || ''}</span>
                    <span class="model-name">${model}</span>
                </div>
            `}).join('');
        }

        function toggleModelSelection(model) {
            const idx = selectedModels.indexOf(model);
            if (idx !== -1) {
                selectedModels.splice(idx, 1);
            } else {
                selectedModels.push(model);
            }
            renderModelCheckboxList();
        }

        function updateSelectedModelCount() {
            document.getElementById('selectedModelCount').textContent = selectedModels.length;
        }

        function renderModelList() {
            const container = document.getElementById('modelList');
            if (selectedModels.length === 0) {
                container.innerHTML = '';
                return;
            }
            container.innerHTML = selectedModels.map((model, index) => `
                <div class="model-tag">
                    <span class="model-tag-order">${index + 1}</span>
                    <span class="model-tag-name" title="${model}">${model}</span>
                    <button class="model-tag-remove" onclick="event.stopPropagation(); removeModel(${index})">×</button>
                </div>
            `).join('');
        }

        function removeModel(index) {
            selectedModels.splice(index, 1);
            renderModelList();
            updateSelectedModelCount();
            onConfigChange();
        }

        function toggleGroup(index) {
            if (openGroups.has(index)) {
                openGroups.delete(index);
            } else {
                openGroups.add(index);
            }
            const group = document.getElementById(`group-${index}`);
            group.classList.toggle('open');
        }

        function toggleFile(fileKey) {
            if (selectedFiles.has(fileKey)) {
                selectedFiles.delete(fileKey);
            } else {
                selectedFiles.add(fileKey);
            }
            renderFileList();
        }

        function selectAll() {
            const searchText = document.getElementById('searchInput').value.toLowerCase();
            uiConfig.formatGroups.forEach(group => {
                (group.files || []).forEach(file => {
                    const fileKey = `${file.source}|${file.testQuestion}`;
                    const showName = file.source.split('/').pop().toLowerCase();
                    if (!searchText || showName.includes(searchText)) {
                        selectedFiles.add(fileKey);
                    }
                });
            });
            renderFileList();
        }

        function selectNone() {
            selectedFiles.clear();
            renderFileList();
        }

        async function onConfigChange() {
            const config = {
                test_set_dir: document.getElementById('testSetDir').value,
                api_key: document.getElementById('apiKey').value,
                base_url: document.getElementById('baseUrl').value,
                models: selectedModels,
                temperature: parseFloat(document.getElementById('modal-temperature').value),
                concurrency: parseInt(document.getElementById('modal-concurrency').value),
                test_count: parseInt(document.getElementById('modal-testCount').value),
                max_retries: parseInt(document.getElementById('modal-maxRetries').value),
                context_size: parseInt(document.getElementById('modal-contextSize').value),
                streaming: document.getElementById('modal-streaming').checked,
                top_p: parseFloat(document.getElementById('modal-topP').value),
                top_k: parseInt(document.getElementById('modal-topK').value),
                min_p: parseFloat(document.getElementById('modal-minP').value)
            };
            try {
                await fetch('/api/v1/config', { 
                    method: 'POST', 
                    headers: { 'Content-Type': 'application/json' }, 
                    body: JSON.stringify(config) 
                });
                await loadUIConfig();
            } catch (error) {
                console.error('Failed to save config:', error);
            }
}

        async function runTests() {
            if (selectedFiles.size === 0) {
                alert('请至少选择一个测试文件');
                return;
            }
            if (selectedModels.length === 0) {
                alert('请至少添加一个模型');
                return;
            }

            const btn = document.getElementById('runBtn');
            const stopBtn = document.getElementById('stopBtn');
            btn.disabled = true;
            stopBtn.disabled = false;
            btn.innerHTML = '测试中...';
            isRunning = true;
            abortController = new AbortController();
            
            document.getElementById('progressContainer').style.display = 'block';
            document.getElementById('progressText').textContent = '正在连接...';
            document.getElementById('progressPercent').textContent = '0%';
            
            allResults = {};
            document.getElementById('aiStreamContent').innerHTML = '';

            try {
                const response = await fetch('/api/v1/run-tests', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        test_files: Array.from(selectedFiles),
                        models: selectedModels
                    }),
                    signal: abortController.signal
                });

                const reader = response.body.getReader();
                const decoder = new TextDecoder();

                while (true) {
                    const { done, value } = await reader.read();
                    if (done) break;
                    
                    const text = decoder.decode(value);
                    const lines = text.split('\n');
                    
                    for (const line of lines) {
                        if (line.startsWith('data: ')) {
                            try {
                                const data = JSON.parse(line.slice(6));
                                handleStreamData(data);
                            } catch (e) {}
                        }
                    }
                }
            } catch (error) {
                if (error.name === 'AbortError') {
                    console.log('测试已终止');
                } else {
                    alert('测试失败: ' + error.message);
                }
            } finally {
                btn.disabled = false;
                stopBtn.disabled = true;
                btn.innerHTML = '开始测试';
                isRunning = false;
                abortController = null;
            }
        }

        function stopTests() {
            fetch('/api/v1/stop-tests', { method: 'POST' });
            if (abortController) {
                abortController.abort();
            }
        }

        function handleStreamData(data) {
            const progressContainer = document.getElementById('progressContainer');
            const progressFill = document.getElementById('progressFill');
            const progressText = document.getElementById('progressText');
            const progressPercent = document.getElementById('progressPercent');
            
            if (data.type === 'status') {
                progressText.textContent = data.message;
                const match = data.message.match(/共 (\d+) 题/);
                if (match) {
                    progressContainer.dataset.total = match[1];
                }
                if (data.message.includes('正在生成')) {
                    document.getElementById('aiStreamStatus').textContent = '生成中';
                }
            } else if (data.type === 'result') {
                const group = data.group;
                if (!allResults[group]) {
                    allResults[group] = [];
                }
                allResults[group].push(data);
                
                addAiStreamItem(data);
                
                const total = parseInt(progressContainer.dataset.total || 0);
                const completed = Object.values(allResults).flat().length;
                const percent = total > 0 ? Math.round(completed / total * 100) : 0;
                progressFill.style.width = percent + '%';
                progressPercent.textContent = percent + '%';
                
                document.getElementById('resultCount').textContent = `${completed} 题`;
            } else if (data.type === 'done') {
                progressText.textContent = data.message;
                document.getElementById('runBtn').disabled = false;
                document.getElementById('stopBtn').disabled = true;
                document.getElementById('runBtn').innerHTML = '开始测试';
                isRunning = false;
            } else if (data.type === 'status' && data.message.includes('已终止')) {
                document.getElementById('runBtn').disabled = false;
                document.getElementById('stopBtn').disabled = true;
                document.getElementById('runBtn').innerHTML = '开始测试';
                isRunning = false;
            }
        }

        function addAiStreamItem(data) {
            const container = document.getElementById('aiStreamContent');
            const empty = container.querySelector('.ai-empty');
            if (empty) empty.remove();
            
            const item = document.createElement('div');
            item.className = 'result-item';
            
            const expectedAnswer = data.expected_answer || '';
            const hasExpected = expectedAnswer.length > 0;
            
            item.innerHTML = `
                <div class="result-header">
                    <span class="result-id">问题 ${data.id}</span>
                </div>
                <div class="result-section">
                    <div class="result-label">期望答案</div>
                    <div class="result-content expected">${hasExpected ? escapeHtml(expectedAnswer) : '暂无'}</div>
                </div>
                <div class="result-section" style="margin-top:6px">
                    <div class="result-label">AI回复</div>
                    <div class="result-content ai">${data.ai_answer ? escapeHtml(data.ai_answer) : '<span style="color:var(--text-muted)">等待响应中...</span>'}</div>
                </div>
            `;
            
            const isFirst = container.querySelectorAll('.result-item').length === 0;
            container.insertBefore(item, container.firstChild);
            if (isFirst) {
                container.scrollTop = 0;
            }
        }

        function escapeHtml(text) {
            if (!text) return '';
            return text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }

        async function clearResults() {
            try {
                await fetch('/api/v1/clear-results', { method: 'POST' });
                allResults = {};
                document.getElementById('aiStreamContent').innerHTML = '<div class="ai-empty"><div class="ai-empty-icon">💭</div><p>开始测试后，这里将显示AI的实时回复</p></div>';
            } catch (error) {
                console.error('Failed to clear results:', error);
            }
        }

        init();
    </script>
</body>
</html>